# 复制本文件为 application-local.yml 并填写真实 Key（application-local.yml 已在 .gitignore 中）
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/mydb
    username: root
    password: 123456
    driver-class-name: org.postgresql.Driver
  ai:
    dashscope:
      api-key: sk-5a813a508d4d431b9b8831e81b07c320
      chat:
        options:
          model: qwen-plus
    vectorstore:
      pgvector:
        index-type: HNSW
        dimensions: 1536
        distance-type: COSINE_DISTANCE
        initialize-schema: true

search-api:
  api-key: your-search-api-key

rag:
  initialize-on-empty: true
  skip-startup-load: false
  embedding-batch-size: 10

logging:
  level:
    org.springframework.ai: DEBUG
